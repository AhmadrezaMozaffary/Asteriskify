{
  "manifest_version": 3,
  "name": "Asteriskify",
  "version": "1.0.0",
  "description": "Spotlight your cursor and asteriskify elements on any website.",
  "permissions": ["storage", "activeTab", "scripting", "contextMenus"],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_title": "Asteriskify",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
